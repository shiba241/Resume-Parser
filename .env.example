# ============================================================
# AI Resume Parser — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# ============================================================

# --- Groq API ---
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Groq Model ---
# Available models: https://console.groq.com/docs/models
# Examples: openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# --- Groq Parameters ---
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=8000
GROQ_MAX_RETRIES=3

# --- Tesseract OCR (Windows) ---
# Default Windows path after installer:
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Processing Limits ---
MAX_RESUMES_PER_BATCH=20
MAX_TEXT_CHARS=15000       # Chars sent to LLM per resume (token control)
MIN_EXTRACTABLE_CHARS=50   # Below this, PDF is treated as scanned (triggers OCR)
